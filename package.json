{
  "name": "civicsync-ph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mts",
    "typecheck": "tsc --noEmit",
    "roadmap": "node --env-file-if-exists=.env.local scripts/roadmap.mts",
    "a11y": "node scripts/a11y.mts",
    "extension:zip": "cd extension && rm -f ../civicsync-extension.zip && zip -qr ../civicsync-extension.zip . -x README.md",
    "start:offline": "BATASWATCH_BASE=http://127.0.0.1:9 next start -p 3100"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^10.14.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.13.0",
    "postcss": "^8.4.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.3"
  },
  "license": "AGPL-3.0-or-later"
}
