# Firebase (optional in dev). Without these, the Watchlist is stored on-device
# only and the "Sign in" button is hidden. Get them from Firebase console →
# Project settings → Your apps → Web app. Enable Authentication → Google.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
