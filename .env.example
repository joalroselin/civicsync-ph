# Firebase (optional in dev). Without these, the Watchlist is stored on-device
# only and the "Sign in" button is hidden. Get them from Firebase console →
# Project settings → Your apps → Web app. Enable Authentication → Google.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sanity CMS (About, Press kit, site settings). Pull real values with:
#   vercel env pull .env.vercel-pull.local   (then copy the SANITY_ lines here)
# Without these, pages fall back to the copy in lib/content-defaults.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_PROJECT_ID=
SANITY_API_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=          # only needed for scripts/seed-content.mts
SANITY_REVALIDATE_SECRET=        # shared with the Sanity publish webhook
