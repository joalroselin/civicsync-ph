{
  "manifest_version": 3,
  "name": "CivicSync PH: Bill status anywhere",
  "short_name": "CivicSync PH",
  "version": "1.0.0",
  "description": "See the live status of Philippine bills (SB / HB numbers) on any page you read. Free, open source, no tracking.",
  "homepage_url": "https://civicsync-ph-gamma.vercel.app",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "CivicSync PH" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://civicsync-ph-gamma.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://civicsync-ph-gamma.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
